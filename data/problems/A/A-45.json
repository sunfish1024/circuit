{
  "id": "A-45",
  "category": "A",
  "title": "交流回路の電圧・電流位相差",
  "difficulty": 2,
  "statement": "図の回路は L1 と R1=1kΩ の直列RL回路である。入力 vin に 1V RMS の正弦波を印加し、出力 out を R1 の両端から取る。周波数 1kHz において、out の位相が vin に対して -30° になるように L1 の値を決定せよ。このとき利得は -1.25dB となる。",
  "prerequisites": [
    "A-43"
  ],
  "judge": "ac",
  "learningGoal": "直列RL回路で電流が電圧より遅れる位相角 φ=-arctan(ωL/R) を理解し、指定の位相差になるインダクタンスを設計できること。",
  "hint": "φ=-arctan(ωL/R)。φ=-30° より ωL/R=tan30°。f=1kHz、R=1kΩ から L を求める。",
  "availableComponents": [
    "L",
    "GND"
  ],
  "fixedComponents": [
    {
      "id": "V1",
      "type": "V_AC",
      "params": {
        "Vpk": 1.414214,
        "freqHz": 1000
      },
      "connect": [
        "vin",
        "gnd"
      ],
      "locked": true
    },
    {
      "id": "R1",
      "type": "R",
      "params": {
        "R": 1000
      },
      "connect": [
        "out",
        "gnd"
      ],
      "locked": true
    }
  ],
  "checks": [
    {
      "type": "bodePoint",
      "frequencyHz": 1000,
      "gainDB": -1.25,
      "phaseDeg": -30,
      "tolerancePct": 5
    },
    {
      "type": "connection",
      "element": "L1",
      "nets": [
        "vin",
        "out"
      ],
      "unordered": true
    }
  ],
  "referenceSolution": [
    {
      "id": "L1",
      "type": "L",
      "params": {
        "L": 0.0919
      },
      "connect": [
        "vin",
        "out"
      ]
    }
  ]
}
