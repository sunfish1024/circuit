{
  "id": "A-02",
  "category": "A",
  "title": "分圧回路で出力電圧を作る",
  "difficulty": 2,
  "statement": "固定電圧源 V1 は 12V で、vin-gnd 間に接続されている。R1 を vin-out 間、R2 を out-gnd 間に配置し、out の電圧が 4V になるように R1 と R2 の値を設定せよ。",
  "prerequisites": [
    "A-01"
  ],
  "judge": "dc",
  "learningGoal": "直列抵抗による分圧比から、所望の出力電圧を得る抵抗値を決める。",
  "hint": "Vout = Vin × R2 / (R1 + R2) である。R1:R2 の比を考える。",
  "availableComponents": [
    "R",
    "GND"
  ],
  "fixedComponents": [
    {
      "id": "V1",
      "type": "V_DC",
      "params": {
        "V": 12
      },
      "connect": [
        "vin",
        "gnd"
      ],
      "locked": true
    }
  ],
  "checks": [
    {
      "type": "dcVoltage",
      "node": "out",
      "expected": 4,
      "tolerancePct": 2,
      "unit": "V"
    }
  ],
  "referenceSolution": [
    {
      "id": "R1",
      "type": "R",
      "params": {
        "R": 20000
      },
      "connect": [
        "vin",
        "out"
      ]
    },
    {
      "id": "R2",
      "type": "R",
      "params": {
        "R": 10000
      },
      "connect": [
        "out",
        "gnd"
      ]
    }
  ]
}
