  "title": "RCハイパスの遮断周波数を合わせる",
  "difficulty": 3,
  "statement": "固定コンデンサ C1=100nF が vin-out 間に接続されている。プレイヤーは R1 を out-gnd 間に配置し、この RC ハイパスフィルタの遮断周波数が 500Hz になるように R1 の値を設定せよ。",
  "prerequisites": [
    "A-12"
  ],
  "judge": "ac",
  "learningGoal": "RCハイパスフィルタの遮断周波数の式から抵抗値を求める。",
  "hint": "fc = 1 / (2πRC) を変形すると R = 1 / (2πfcC) である。f = 500Hz、C = 100×10^-9 F を代入する。",
  "availableComponents": [
    "R",
    "GND"
  ],
  "fixedComponents": [
    {
      "id": "C1",
      "type": "C",
      "params": {
        "C": 1e-07
      },
      "connect": [
        "vin",
        "out"
      ],
      "locked": true
    }
  ],
  "checks": [
    {
      "type": "componentValue",
